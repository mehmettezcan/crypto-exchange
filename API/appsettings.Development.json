{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "TestConnection": "Data Source=cryptoexchange.db"
  },
  "AllowedHosts": "*",
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyForJWTTokenGeneration-Minimum32Characters",
    "Issuer": "CryptoExchangeApp",
    "Audience": "CryptoExchangeAppUsers",
    "ExpirationMinutes": 60
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173"
    ]
  },
  "OkxSettings": {
    "WebSocketUrl": "wss://ws.okx.com:8443/ws/v5/public",
    "Symbols": [
      "BTC-USDT",
      "ETH-USDT",
      "BNB-USDT",
      "ADA-USDT",
      "DOGE-USDT",
      "XRP-USDT",
      "LINK-USDT",
      "LTC-USDT"
    ]
  }
}